# NOTE: .git is deliberately *not* ignored -- hatch-vcs reads the version from
# git history at build time. So nothing tracked may be ignored here either: git
# would see it deleted and version the image as a dirty dev build (#50). Check
# with `git ls-files -ci --exclude-from=.dockerignore`, which must print nothing.
.venv
venv
dist
build
*.egg-info
**/__pycache__
**/*.py[cod]
.pytest_cache
.ruff_cache
.mypy_cache
.coverage
htmlcov

# Local data, job output and settings: mounted at run time, never baked into the image.
# data/<dir>/.gitkeep is tracked, so only what sits beside it is ignored.
.env
data/*/*
!data/*/.gitkeep
/jobs
/output
