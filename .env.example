# ── Server ───────────────────────────────────────────────────────────
# Host port for the argus-atlas FastAPI server (peer to lens :8100,
# curator :8101, quarry :8102, forge :8103, proof :8104).
ATLAS_PORT=8105

# Browser origins allowed by `argus-atlas serve --cors` (comma-separated).
ATLAS_CORS_ORIGINS=http://localhost:3000

# ── Safety posture ───────────────────────────────────────────────────
# Live baking is OFF unless this is 1/true/yes/on. Unset, `argus-atlas bake`
# refuses (exit 3) and POST /bake/stream returns 403, while controls, tiles and
# every stored-job GET keep working — the same demo-safe default as forge and
# proof (argus-halo#7). GET /health echoes it as `read_only`.
#ATLAS_ALLOW_BAKE=1

# ── Storage ──────────────────────────────────────────────────────────
# Job sidecars, controls, GeoTIFFs and PMTiles: <jobs dir>/<job_id>/job.json
ATLAS_JOBS_DIR=/data/out/atlas
# Only DEMs (and land polygon files) under this root can be named by the API.
ATLAS_DEM_DIR=/data/dem
# Checkpoints + LoRAs in the ComfyUI layout (checkpoints/, loras/). Read-only;
# used to SHA256-pin the models a bake used, not to load them.
ATLAS_MODELS_DIR=/data/models

# ── Generation backend ───────────────────────────────────────────────
# Backend key (only `comfyui` ships in v0).
ATLAS_BACKEND=comfyui
# A ComfyUI reachable FROM THE CONTAINER. The default targets one running on
# the compose host (compose sets extra_hosts: host.docker.internal:host-gateway).
COMFYUI_BASE_URL=http://host.docker.internal:8188
# ComfyUI API-format workflow with $placeholders. Unset = the packaged starter
# (src/argus_atlas/templates/comfyui_sdxl_img2img_control.json). ControlNet
# choice and weight live in this file, not in Python.
#ATLAS_WORKFLOW=/data/models/workflows/atlas.json
