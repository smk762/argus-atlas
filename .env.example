# Copy to .env. compose.yaml reads it (`cp .env.example .env`); outside compose, export what you need
# (not by sourcing the whole file: UID is read-only in bash, so `. .env` fails on it).

# ── Compose host ─────────────────────────────────────────────────────
# Your uid/gid (`id -u`, `id -g`), so job files on the mounts are yours, not
# root's. Bash does not export UID, so compose only sees it from here.
UID=1000
GID=1000
# Host directories compose mounts at /data/dem, /data/recipes (read-only),
# /data/models (read-only) and /data/out/atlas. Defaults: ./data/{dem,models,jobs}
# and examples/recipes. On a GPU host, for example:
#ATLAS_DEM_HOST=<DATA_ROOT>/dem
#ATLAS_RECIPES_HOST=<DATA_ROOT>/recipes
#ATLAS_MODELS_HOST=<COMFYUI_MODELS_DIR>
#ATLAS_JOBS_HOST=<DATA_ROOT>/jobs
# Host address the API binds to (127.0.0.1 keeps it off the network).
#ATLAS_BIND=127.0.0.1
# Tag compose gives the image it builds from this checkout and then runs. It is
# always built here, never pulled: naming a release (GHCR) tag does not pin one,
# it only labels the local build with that name.
#ATLAS_IMAGE=argus-atlas:local

# ── Server ───────────────────────────────────────────────────────────
# Host port for the argus-atlas FastAPI server (peer to lens :8100,
# curator :8101, quarry :8102, forge :8103, proof :8104).
ATLAS_PORT=8105

# Browser origins allowed by `argus-atlas serve --cors` (comma-separated;
# * for examples/viewer.html opened from file://).
ATLAS_CORS_ORIGINS=http://localhost:3000

# ── Safety posture ───────────────────────────────────────────────────
# Live baking is OFF unless this is 1/true/yes/on. Unset, `argus-atlas bake`
# refuses (exit 3) and POST /bake/stream returns 403, while controls, tiles and
# every stored-job GET keep working — the same demo-safe default as forge and
# proof (argus-halo#7). GET /health echoes it as `read_only`.
#ATLAS_ALLOW_BAKE=1
# POST /osm (the server fetching from Overpass) is off unless this is set too.
# The `osm` and `dem` CLI commands need no flag.
#ATLAS_ALLOW_OSM=1

# ── Storage ──────────────────────────────────────────────────────────
# Paths inside the container. The image sets these; compose mounts the
# *_HOST directories above onto them. Change them only outside compose.
# Job sidecars, controls, GeoTIFFs and PMTiles: <jobs dir>/<job_id>/job.json
ATLAS_JOBS_DIR=/data/out/atlas
# Only DEMs (and land polygon files) under this root can be named by the API.
ATLAS_DEM_DIR=/data/dem
# Checkpoints + LoRAs in the ComfyUI layout (checkpoints/, loras/). Read-only;
# used to SHA256-pin the models a bake used, not to load them.
ATLAS_MODELS_DIR=/data/models

# ── Generation backend ───────────────────────────────────────────────
# Backend key (only `comfyui` ships in v0).
ATLAS_BACKEND=comfyui
# A ComfyUI reachable FROM THE CONTAINER. The default targets one running on
# the compose host (compose sets extra_hosts: host.docker.internal:host-gateway).
COMFYUI_BASE_URL=http://host.docker.internal:8188
# Remote GPU box instead: COMFYUI_BASE_URL=http://<GPU_HOST>:8188 (real host/IP in your local .env)
# ComfyUI API-format workflow with $placeholders. Unset = the packaged starter
# (src/argus_atlas/templates/comfyui_sdxl_img2img_control.json). ControlNet
# choice and weight live in this file, not in Python.
#ATLAS_WORKFLOW=/data/models/workflows/atlas.json

# ── Sources the CLI fetches from ─────────────────────────────────────
# Copernicus GLO-30 tiles for `argus-atlas dem` (a mirror URL or a local dir).
#ATLAS_DEM_SOURCE=https://copernicus-dem-30m.s3.amazonaws.com
# Overpass endpoint for `argus-atlas osm` and POST /osm.
#ATLAS_OVERPASS_URL=https://overpass-api.de/api/interpreter

# ── Agent tooling (not read by this service) ──
# ai-code-auditor audit API base that AGENTS.md tells coding agents to use.
# Put the real host/IP in your local .env, never here.
# AI_AUDIT_PUBLIC_BASE_URL=http://<AUDIT_HOST>:8765
