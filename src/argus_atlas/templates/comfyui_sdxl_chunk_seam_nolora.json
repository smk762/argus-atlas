{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "$checkpoint"
    }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "$positive",
      "clip": [
        "1",
        1
      ]
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "$negative",
      "clip": [
        "1",
        1
      ]
    }
  },
  "5": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "$hillshade",
      "upload": "image"
    }
  },
  "6": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "5",
        0
      ],
      "upscale_method": "lanczos",
      "width": "$width",
      "height": "$height",
      "crop": "disabled"
    }
  },
  "7": {
    "class_type": "VAEEncode",
    "inputs": {
      "pixels": [
        "14",
        0
      ],
      "vae": [
        "1",
        2
      ]
    }
  },
  "8": {
    "class_type": "ControlNetLoader",
    "inputs": {
      "control_net_name": "diffusers_xl_depth_full.safetensors"
    }
  },
  "9": {
    "class_type": "ControlNetApplyAdvanced",
    "inputs": {
      "positive": [
        "3",
        0
      ],
      "negative": [
        "4",
        0
      ],
      "control_net": [
        "8",
        0
      ],
      "image": [
        "6",
        0
      ],
      "strength": 0.65,
      "start_percent": 0.0,
      "end_percent": 0.8
    }
  },
  "10": {
    "class_type": "KSampler",
    "inputs": {
      "seed": "$seed",
      "steps": "$steps",
      "cfg": "$cfg",
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": "$denoise",
      "model": [
        "1",
        0
      ],
      "positive": [
        "9",
        0
      ],
      "negative": [
        "9",
        1
      ],
      "latent_image": [
        "16",
        0
      ]
    }
  },
  "11": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "10",
        0
      ],
      "vae": [
        "1",
        2
      ]
    }
  },
  "12": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "argus-atlas",
      "images": [
        "11",
        0
      ]
    }
  },
  "13": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "$seam_init",
      "upload": "image"
    }
  },
  "14": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "13",
        0
      ],
      "upscale_method": "lanczos",
      "width": "$width",
      "height": "$height",
      "crop": "disabled"
    }
  },
  "15": {
    "class_type": "LoadImageMask",
    "inputs": {
      "image": "$seam_mask",
      "channel": "red",
      "upload": "image"
    }
  },
  "16": {
    "class_type": "SetLatentNoiseMask",
    "inputs": {
      "samples": [
        "7",
        0
      ],
      "mask": [
        "15",
        0
      ]
    }
  }
}
